# انسخ الملف ده باسم .env في نفس المكان (جذر الريبو) قبل تشغيل docker compose up
# .env مش متتبع في Git (راجع .gitignore) - القيم هنا Placeholders بس

# SQL Server (Container)
SA_PASSWORD=Your_password123!

# Backend (SubscriptionTracker.Api)
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_BOOTSTRAP_KEY=REPLACE_WITH_A_RANDOM_SECRET_BEFORE_FIRST_RUN

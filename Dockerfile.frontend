# Frontend (Angular) - Multi-stage build: بيبني الـ Static Files وبيقدّمهم عن طريق Nginx
# شغّله من جذر الريبو: docker build -f Dockerfile.frontend -t subscription-tracker-app .

# node:22 — the Angular CLI states a minimum of v22.22.3, so node:18 could not run `ng build`
# at all ("The Angular CLI requires a minimum Node.js version", exit code 3). This was masked
# until now because the image tag was rejected by GHCR before the build was ever reached.
FROM node:22-alpine AS build
WORKDIR /app

COPY subscription-tracker-app/package*.json ./
RUN npm ci

COPY subscription-tracker-app/ ./
RUN npm run build

FROM nginx:alpine AS runtime
# Angular 18 (new application builder) بيحط الناتج جوه مجلد /browser
COPY --from=build /app/dist/subscription-tracker-app/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

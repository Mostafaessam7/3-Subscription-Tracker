{
  "_comment": "انسخ الملف ده باسم appsettings.json (أو appsettings.Development.json) واملأ القيم بتاعتك. ماترفعش appsettings.json الحقيقي على Git لو فيه أسرار حقيقية.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=SubscriptionTrackerDb;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "Issuer": "SubscriptionTracker.Api",
    "Audience": "SubscriptionTracker.App",
    "ExpiresInHours": "8"
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "Username": "your-email@example.com",
    "Password": "REPLACE_WITH_AN_APP_PASSWORD",
    "FromAddress": "your-email@example.com",
    "FromName": "Subscription Tracker"
  },
  "Admin": {
    "BootstrapKey": "REPLACE_WITH_A_RANDOM_SECRET_BEFORE_FIRST_RUN"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}

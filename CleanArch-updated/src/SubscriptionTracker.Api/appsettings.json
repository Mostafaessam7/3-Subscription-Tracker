{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SubscriptionTrackerDb;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "Issuer": "SubscriptionTracker.Api",
    "Audience": "SubscriptionTracker.App",
    "ExpiresInHours": "8"
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "Username": "your-email@gmail.com",
    "Password": "CHANGE_THIS_TO_AN_APP_PASSWORD",
    "FromAddress": "your-email@gmail.com",
    "FromName": "Subscription Tracker"
  },
  "Admin": {
    "BootstrapKey": "CHANGE_THIS_TO_A_RANDOM_SECRET_BEFORE_FIRST_RUN"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimiting": {
    "AuthEndpoints": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
